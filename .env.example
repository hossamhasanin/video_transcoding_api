# ==========================================
# GLOBAL / CONTROL PLANE SETTINGS
# ==========================================
# Bind Postgres/Redis to specific IP (127.0.0.1 for localhost, Tailscale IP for multi-node)
BIND_IP=127.0.0.1

# Domain name for Traefik routing (e.g., api.yourdomain.com)
DOMAIN=yourdomain.com

# Email for Let's Encrypt SSL Certificate generation
SSL_EMAIL=admin@yourdomain.com

# ==========================================
# DATABASE CREDENTIALS
# ==========================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password

# ==========================================
# REDIS CREDENTIALS
# ==========================================
REDIS_PASSWORD=your_secure_redis_password

# ==========================================
# CORS SETTINGS
# ==========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ==========================================
# JOB LIMITS
# ==========================================
MAX_CONCURRENT_JOBS=10
MAX_UPLOAD_SIZE_MB=500

# ==========================================
# WORKER NODE SETTINGS
# ==========================================
# The Tailscale IP of your Control Plane (for multi-node setup)
CONTROL_PLANE_IP=100.x.x.x

# ==========================================
# STORAGE API KEYS (Cloudflare R2 / AWS S3)
# ==========================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=video-transcoding

# Optional: Custom S3 Endpoint URL (Required for Cloudflare R2 or MinIO)
S3_ENDPOINT_URL=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# Webhook secret for securing callback requests
WEBHOOK_SECRET_KEY=your_webhook_secret_key
