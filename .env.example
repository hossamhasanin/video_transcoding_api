# ==========================================
# 🌐 GLOBAL / CONTROL PLANE SETTINGS (VPS 1)
# ==========================================
# Your Tailscale Private IP for the Control Plane (e.g., 100.x.x.x)
# This binds Postgres and Redis to the secure Tailscale network.
BIND_IP=100.x.x.x

# Domain name for Traefik routing (e.g., api.yourdomain.com)
# Leave as localhost or your public IP if testing without a domain.
DOMAIN=yourdomain.com

# Email for Let's Encrypt SSL Certificate generation
SSL_EMAIL=admin@yourdomain.com

# ==========================================
# 🔒 DATABASE CREDENTIALS (All VPS Nodes)
# ==========================================
# These must match across all your servers (Control Plane and Workers)
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_super_secure_database_password

# ==========================================
# 🚀 WORKER NODE SETTINGS (VPS 2 & VPS 3)
# ==========================================
# The Tailscale IP of your Control Plane (VPS 1)
# Workers use this to connect to the database and Redis queues.
CONTROL_PLANE_IP=100.x.x.x

# ==========================================
# 📦 BACKEND / STORAGE API KEYS (All VPS Nodes)
# ==========================================
# These are loaded by the FastAPI backend and Celery workers to interact with S3/R2.
# Note: For Docker Compose, you should copy this file to `backend/.env` as well.

# Cloudflare R2 or AWS S3 Credentials
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=video-transcoding

# Optional: Custom S3 Endpoint URL (Required for Cloudflare R2 or MinIO)
# Example: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# Webhook secret for securing callback requests
WEBHOOK_SECRET_KEY=your_secure_webhook_secret_key
