# ==========================================
# GLOBAL / CONTROL PLANE SETTINGS
# ==========================================
# Bind Postgres/Redis to specific IP (127.0.0.1 for localhost, Tailscale IP for multi-node)
BIND_IP=127.0.0.1

# Domain name for Traefik routing (e.g., api.yourdomain.com)
DOMAIN=yourdomain.com

# Email for Let's Encrypt SSL Certificate generation
SSL_EMAIL=admin@yourdomain.com

# ==========================================
# DATABASE CREDENTIALS
# ==========================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password

# ==========================================
# REDIS CREDENTIALS
# ==========================================
REDIS_PASSWORD=your_secure_redis_password

# ==========================================
# JWT AUTHENTICATION
# ==========================================
# IMPORTANT: Generate a random secret key! Use: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Frontend URL (used for email links like password reset, email verification)
FRONTEND_URL=https://yourdomain.com

# ==========================================
# CORS SETTINGS
# ==========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ==========================================
# JOB LIMITS
# ==========================================
MAX_CONCURRENT_JOBS=10
MAX_UPLOAD_SIZE_MB=500

# ==========================================
# WORKER NODE SETTINGS
# ==========================================
# The Tailscale IP of your Control Plane (for multi-node setup)
CONTROL_PLANE_IP=100.x.x.x

# ==========================================
# STORAGE API KEYS (Cloudflare R2 / AWS S3)
# ==========================================
# Required for worker containers (--profile worker, --profile ml).
# Not needed for auth/dashboard-only testing.
# See LOCAL_TESTING.md "Setting Up Cloudflare R2" for instructions.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=video-transcoding

# Optional: Custom S3 Endpoint URL (auto-constructed from R2_ACCOUNT_ID if empty)
S3_ENDPOINT_URL=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# Webhook secret for securing callback requests
WEBHOOK_SECRET_KEY=your_webhook_secret_key

# API base URL (used by workers to build accessible output URLs for webhooks)
API_BASE_URL=http://localhost:8000
